{#
 # A configuration card: a section with its icon, opening on its pages. A module
 # card adds the switch that shows its page in the menu.
 #}
{% macro card(card, switchLabel) %}
    <div class="puik-card puik-card--default hover:shadow gap-1 overflow-hidden peb-card"{% if switchLabel %} data-class-name="{{ card.class_name }}"{% endif %}>
        {% if switchLabel %}<div class="flex items-center justify-between gap-x-4">{% endif %}
        <a href="{{ card.href }}" class="flex items-center justify-between no-underline cursor-pointer peb-card__header"{% if card.links is not empty %} aria-expanded="false"{% endif %}>
            <div class="flex items-center gap-x-3">
                <span class="puik-icon p-5 bg-[#EFF3F7] text-[#505969] text-3xl rounded-full w-14 h-14 flex items-center justify-center">{{ card.icon }}</span>
                <div class="flex flex-col gap-y-0.5" data-test="{{ card.class_name }}-block">
                    <h1 class="puik-h3" data-test="title-block">{{ card.name }}</h1>
                    {% if card.description is not empty %}<span data-test="description-block">{{ card.description }}</span>{% endif %}
                </div>
            </div>
            {% if card.links is not empty %}<span class="puik-icon text-xl font-normal peb-card__arrow">expand_more</span>{% endif %}
        </a>
        {% if switchLabel %}
            <button type="button" role="switch" class="peb-switch"
                    aria-checked="{{ card.shown ? 'true' : 'false' }}"
                    aria-label="{{ switchLabel }}" title="{{ switchLabel }}">
                <span class="peb-switch__toggle"></span>
            </button>
        </div>
        {% endif %}
        {% if card.links is not empty %}
            <div class="overflow-hidden max-h-0 peb-card__pages">
                <div class="h-[1px] rounded w-full my-2 bg-[#E4EBF2]"></div>
                <div class="grid grid-cols-3">
                    {% for page in card.links %}
                        <a href="{{ page.href }}" target="_self" class="puik-link puik-link--lg">{{ page.name }}</a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
{% endmacro %}

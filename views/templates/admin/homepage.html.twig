{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
    <div id="vue-app" data-context="{{ jsContext|e }}"></div>

    {# Module pages, with a switch to show each in the menu. Kept hidden until
       menu-modules.js moves it under the app's cards, whose styles it borrows. #}
    {% if menuModules is not empty %}
        <link rel="stylesheet" href="{{ menuModulesAssets.css }}">
        <div id="peb-menu-modules" hidden
             data-url="{{ menuModulesUrl }}" data-error="{{ menuModulesTexts.error }}">
            <div class="flex flex-col gap-y-0.5">
                <h1 class="puik-h3">{{ menuModulesTexts.title }}</h1>
                <span>{{ menuModulesTexts.description }}</span>
            </div>
            {% for card in menuModules %}
                <div class="puik-card puik-card--default hover:shadow gap-1 overflow-hidden" data-class-name="{{ card.class_name }}">
                    <div class="flex items-center justify-between gap-x-4">
                        <a href="{{ card.href }}" class="flex items-center gap-x-3 no-underline cursor-pointer peb-menu-modules__link">
                            <span class="puik-icon p-5 bg-[#EFF3F7] text-[#505969] text-3xl rounded-full w-14 h-14 flex items-center justify-center">{{ card.icon }}</span>
                            <div class="flex flex-col gap-y-0.5">
                                <h1 class="puik-h3">{{ card.name }}</h1>
                                {% if card.description is not empty %}<span>{{ card.description }}</span>{% endif %}
                            </div>
                        </a>
                        <button type="button" role="switch" class="peb-switch"
                                aria-checked="{{ card.shown ? 'true' : 'false' }}"
                                aria-label="{{ menuModulesTexts.switch }}" title="{{ menuModulesTexts.switch }}">
                            <span class="peb-switch__toggle"></span>
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>
        <script src="{{ menuModulesAssets.js }}" defer></script>
    {% endif %}
{% endblock %}

{% extends '@PrestaShop/Admin/layout.html.twig' %}

{#
 # The settings page in two levels, drawn only with the back office's own classes:
 # the sections first, then the pages of the one clicked, in place. Every view is
 # in the page from the start, so changing view only swaps which one shows. With
 # no script, a section card is a link to its first page.
 #}
{% macro icon(name) %}
    <span class="material-icons rounded-circle bg-light text-muted p-3 mr-3 peb-settings__icon" aria-hidden="true">{{ name }}</span>
{% endmacro %}

{% block content %}
    <link rel="stylesheet" href="{{ pageAssets.css }}">
    <div id="peb-settings" class="peb-settings" data-home-title="{{ texts.title }}" data-home-description="{{ texts.description }}">
        <div class="mb-3">
            <h2 class="mb-1" data-peb-title>{{ texts.title }}</h2>
            <p class="text-muted mb-0" data-peb-description>{{ texts.description }}</p>
        </div>

        <div class="row" data-peb-view="home">
            {% for card in cards %}
                <div class="{{ card.wide ? 'col-lg-8' : 'col-lg-4' }} mb-4">
                    <div class="card h-100 mb-0 peb-settings__card">
                        <div class="card-body d-flex align-items-center">
                            {{ _self.icon(card.icon) }}
                            <div class="peb-settings__text" data-test="{{ card.class_name }}-block">
                                <a href="{{ card.links is not empty ? card.links[0].href : card.href }}" class="stretched-link text-reset font-weight-bold peb-settings__name"
                                   {% if card.links is not empty %}data-peb-open="section-{{ loop.index }}"{% endif %}>{{ card.name }}</a>
                                {% if card.description is not empty %}<div class="text-muted small mt-1">{{ card.description }}</div>{% endif %}
                            </div>
                            <i class="material-icons text-muted ml-3" aria-hidden="true">chevron_right</i>
                        </div>
                    </div>
                </div>
            {% endfor %}
            {% if menuModules is not empty %}
                <div class="col-lg-4 mb-4">
                    <div class="card h-100 mb-0 peb-settings__card">
                        <div class="card-body d-flex align-items-center">
                            {{ _self.icon('menu') }}
                            <div class="peb-settings__text">
                                <a href="#modules" class="stretched-link text-reset font-weight-bold peb-settings__name" data-peb-open="modules">{{ texts.switch }}</a>
                                <div class="text-muted small mt-1">{{ texts.modulesDescription }}</div>
                            </div>
                            <i class="material-icons text-muted ml-3" aria-hidden="true">chevron_right</i>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        {% for card in cards %}
            {% if card.links is not empty %}
                <div class="row" data-peb-view="section-{{ loop.index }}" data-title="{{ card.name }}" data-description="{{ card.description }}" hidden>
                    {% for page in card.links %}
                        <div class="col-lg-4 mb-4">
                            <div class="card h-100 mb-0 peb-settings__card">
                                <div class="card-body d-flex align-items-center">
                                    {{ _self.icon(card.icon) }}
                                    <a href="{{ page.href }}" class="stretched-link text-reset font-weight-bold peb-settings__name peb-settings__text">{{ page.name }}</a>
                                    <i class="material-icons text-muted ml-3" aria-hidden="true">chevron_right</i>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endfor %}

        {% if menuModules is not empty %}
            <div id="peb-menu-modules" class="row" data-peb-view="modules" data-title="{{ texts.switch }}" data-description="{{ texts.modulesDescription }}"
                 data-url="{{ menuModulesUrl }}" data-error="{{ texts.error }}" hidden>
                {% for card in menuModules %}
                    <div class="col-lg-4 mb-4">
                        <div class="card h-100 mb-0 peb-settings__card" data-class-name="{{ card.class_name }}">
                            <div class="card-body d-flex align-items-center">
                                {{ _self.icon(card.icon) }}
                                <div class="peb-settings__text">
                                    <a href="{{ card.href }}" class="text-reset font-weight-bold peb-settings__name">{{ card.name }}</a>
                                    {% if card.description is not empty %}<div class="text-muted small mt-1">{{ card.description }}</div>{% endif %}
                                </div>
                                <span class="ps-switch ps-switch-sm ml-3 peb-settings__switch" title="{{ texts.switch }}">
                                    <input type="radio" name="peb-menu-{{ loop.index }}" id="peb-menu-{{ loop.index }}-off" value="0"{% if not card.shown %} checked{% endif %}>
                                    <label for="peb-menu-{{ loop.index }}-off">{{ texts.no }}</label>
                                    <input type="radio" name="peb-menu-{{ loop.index }}" id="peb-menu-{{ loop.index }}-on" value="1"{% if card.shown %} checked{% endif %}>
                                    <label for="peb-menu-{{ loop.index }}-on">{{ texts.yes }}</label>
                                    <span class="slide-button"></span>
                                </span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {# Shown for a moment while the view changes. #}
        <div class="row" data-peb-view="waiting" hidden>
            {% for i in 1..6 %}
                <div class="col-lg-4 mb-4">
                    <div class="card h-100 mb-0 peb-settings__waiting">
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <span class="spinner-border text-secondary" role="status"></span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="d-flex align-items-center mt-2" data-peb-nav hidden>
            <a href="#" class="btn btn-outline-primary" data-peb-back>
                <i class="material-icons peb-settings__back" aria-hidden="true">chevron_left</i> {{ texts.title }}
            </a>
            <span class="mx-3 text-muted" data-peb-trail></span>
        </div>
    </div>
    <script src="{{ pageAssets.js }}" defer></script>
{% endblock %}

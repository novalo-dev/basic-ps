{% extends '@PrestaShop/Admin/layout.html.twig' %}

{#
 # The settings page in two levels, drawn only with the back office's own classes:
 # the sections three to a row with the module pages under them, one per row,
 # then the pages of the section clicked, in place. Every view is
 # in the page from the start, so changing view only swaps which one shows. With
 # no script, a section card is a link to its first page.
 #}
{% macro icon(name) %}
    <span class="rounded-circle bg-light text-muted p-3 mr-3 peb-settings__icon" aria-hidden="true"><i class="material-icons">{{ name }}</i></span>
{% endmacro %}

{% block content %}
    <link rel="stylesheet" href="{{ pageAssets.css }}">
    <div id="peb-settings" class="peb-settings" data-home-title="{{ texts.title }}" data-home-description="{{ texts.description }}">
        <div class="mb-3">
            <h2 class="mb-1" data-peb-title>{{ texts.title }}</h2>
            <p class="text-muted mb-0" data-peb-description>{{ texts.description }}</p>
        </div>

        <div data-peb-view="home">
        <div class="row peb-settings__grid">
            {% for card in cards %}
                <div class="{{ card.wide ? 'col-lg-8 peb-settings__wide' : 'col-lg-4' }} mb-4">
                    <div class="card h-100 mb-0 peb-settings__card">
                        <div class="card-body d-flex align-items-center">
                            {{ _self.icon(card.icon) }}
                            <div class="peb-settings__text" data-test="{{ card.class_name }}-block">
                                <a href="{{ card.links is not empty ? card.links[0].href : card.href }}" class="stretched-link text-reset font-weight-bold peb-settings__name"
                                   {% if card.links is not empty %}data-peb-open="section-{{ loop.index }}"{% endif %}>{{ card.name }}</a>
                                {% if card.description is not empty %}<div class="text-muted small mt-1">{{ card.description }}</div>{% endif %}
                            </div>
                            <i class="material-icons text-muted ml-3" aria-hidden="true">chevron_right</i>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        {% if menuModules is not empty %}
            <div id="peb-menu-modules" data-url="{{ menuModulesUrl }}" data-error="{{ texts.error }}">
                <div class="mb-3">
                    <h2 class="mb-1">{{ texts.modulesTitle }}</h2>
                    <p class="text-muted mb-0">{{ texts.modulesDescription }}</p>
                </div>
                <div class="row">
                {% for card in menuModules %}
                    <div class="col-12 mb-4">
                        <div class="card h-100 mb-0 peb-settings__card" data-class-name="{{ card.class_name }}">
                            <div class="card-body d-flex align-items-center">
                                {{ _self.icon(card.icon) }}
                                <div class="peb-settings__text">
                                    <a href="{{ card.links is not empty ? card.links[0].href : card.href }}" class="stretched-link text-reset font-weight-bold peb-settings__name"
                                       {% if card.links is not empty %}data-peb-open="module-{{ loop.index }}"{% endif %}>{{ card.name }}</a>
                                    {% if card.description is not empty %}<div class="text-muted small mt-1">{{ card.description }}</div>{% endif %}
                                </div>
                                {# The switch, then the arrow at the very right. #}
                                <span class="ps-switch ps-switch-nolabel ml-3 peb-settings__switch" title="{{ texts.switchHelp }}" aria-label="{{ texts.switch }}">
                                    <input type="radio" name="peb-menu-{{ loop.index }}" id="peb-menu-{{ loop.index }}-off" value="0"{% if not card.shown %} checked{% endif %}>
                                    <label for="peb-menu-{{ loop.index }}-off">{{ texts.no }}</label>
                                    <input type="radio" name="peb-menu-{{ loop.index }}" id="peb-menu-{{ loop.index }}-on" value="1"{% if card.shown %} checked{% endif %}>
                                    <label for="peb-menu-{{ loop.index }}-on">{{ texts.yes }}</label>
                                    <span class="slide-button"></span>
                                </span>
                                {# Every card leads somewhere: its pages, or the module's own page. #}
                                <i class="material-icons text-muted ml-2" aria-hidden="true">chevron_right</i>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                </div>
            </div>
        {% endif %}

            {% set n = notifications %}
            <div id="peb-notifications">
                <div class="mb-3">
                    <h2 class="mb-1">{{ n.texts.title }}</h2>
                    <p class="text-muted mb-0">{{ n.texts.description }}</p>
                </div>
                <div class="row">
                    {# Notifications belong to a browser, not to an account: each one is switched on where it is used. #}
                    <div class="col-12 mb-4">
                        <div class="card h-100 mb-0 peb-settings__card" id="peb-push"
                             data-key="{{ n.publicKey }}" data-worker="{{ n.worker }}"
                             data-subscribe="{{ n.urls.subscribe }}" data-unsubscribe="{{ n.urls.unsubscribe }}" data-test="{{ n.urls.test }}"
                             data-text-on="{{ n.texts.on }}" data-text-off="{{ n.texts.off }}" data-text-denied="{{ n.texts.denied }}" data-text-unblock="{{ n.texts.unblock }}"
                             data-text-unsupported="{{ n.texts.unsupported }}" data-text-insecure="{{ n.texts.insecure }}" data-text-no-server="{{ n.texts.noServer }}"
                             data-text-sent="{{ n.texts.testSent }}" data-text-failed="{{ n.texts.testFailed }}" data-error="{{ texts.error }}">
                            <div class="card-body d-flex align-items-center">
                                {{ _self.icon('notifications_active') }}
                                <div class="peb-settings__text">
                                    <div class="font-weight-bold peb-settings__name">{{ n.texts.browser }}</div>
                                    <div class="text-muted small mt-1" data-peb-push-status aria-live="polite"></div>
                                </div>
                                <div class="ml-3 text-nowrap">
                                    <button type="button" class="btn btn-outline-secondary" data-peb-push-test hidden>{{ n.texts.test }}</button>
                                    <button type="button" class="btn btn-outline-secondary ml-2" data-peb-push-off hidden>{{ n.texts.turnOff }}</button>
                                    <button type="button" class="btn btn-primary ml-2" data-peb-push-on hidden>{{ n.texts.turnOn }}</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 mb-4">
                        <div class="card h-100 mb-0 peb-settings__card">
                            <div class="card-body d-flex align-items-center">
                                {{ _self.icon('tune') }}
                                <div class="peb-settings__text">
                                    <a href="#notifications" class="stretched-link text-reset font-weight-bold peb-settings__name" data-peb-open="notifications">{{ n.texts.settings }}</a>
                                    <div class="text-muted small mt-1">{{ n.texts.settingsDescription }}</div>
                                </div>
                                <i class="material-icons text-muted ml-3" aria-hidden="true">chevron_right</i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" data-peb-view="notifications" data-title="{{ notifications.texts.settings }}" data-description="{{ notifications.texts.settingsDescription }}" hidden>
            <div class="col-12 mb-4">
                <form class="card mb-0" id="peb-notifications-form" action="{{ notifications.urls.save }}" method="post" data-error="{{ texts.error }}">
                    <div class="card-body">
                        {% for kind, enabled in notifications.kinds %}
                            <div class="form-group row align-items-center">
                                <label class="col-sm-5 col-form-label">{{ notifications.texts[kind] }}</label>
                                <div class="col-sm-7">
                                    <span class="ps-switch">
                                        <input type="radio" name="{{ kind }}" id="peb-kind-{{ kind }}-0" value="0"{% if not enabled %} checked{% endif %}{% if not notifications.canEdit %} disabled{% endif %}>
                                        <label for="peb-kind-{{ kind }}-0">{{ texts.no }}</label>
                                        <input type="radio" name="{{ kind }}" id="peb-kind-{{ kind }}-1" value="1"{% if enabled %} checked{% endif %}{% if not notifications.canEdit %} disabled{% endif %}>
                                        <label for="peb-kind-{{ kind }}-1">{{ texts.yes }}</label>
                                        <span class="slide-button"></span>
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                        <div class="form-group row">
                            <div class="offset-sm-5 col-sm-7"><small class="form-text text-muted mt-0">{{ notifications.texts.kindsHelp }}</small></div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-sm-5 col-form-label" for="peb-notify-background">{{ notifications.texts.background }}</label>
                            <div class="col-sm-7">
                                <input type="color" class="form-control peb-settings__color" id="peb-notify-background" name="background" value="{{ notifications.background }}"{% if not notifications.canEdit %} disabled{% endif %}>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-sm-5 col-form-label" for="peb-notify-text">{{ notifications.texts.textColor }}</label>
                            <div class="col-sm-7">
                                <input type="color" class="form-control peb-settings__color" id="peb-notify-text" name="text" value="{{ notifications.text }}"{% if not notifications.canEdit %} disabled{% endif %}>
                            </div>
                        </div>
                        <div class="form-group row align-items-center mb-0">
                            <label class="col-sm-5 col-form-label" for="peb-notify-validity">{{ notifications.texts.validity }}</label>
                            <div class="col-sm-7">
                                <select class="custom-select" id="peb-notify-validity" name="validity"{% if not notifications.canEdit %} disabled{% endif %}>
                                    {% for seconds, label in notifications.validities %}
                                        <option value="{{ seconds }}"{% if seconds == notifications.validity %} selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                                <small class="form-text text-muted">{{ notifications.texts.validityHelp }}</small>
                            </div>
                        </div>
                    </div>
                    {% if notifications.canEdit %}
                        <div class="card-footer d-flex align-items-center justify-content-end">
                            <span class="text-success mr-3" data-peb-saved hidden>{{ notifications.texts.saved }}</span>
                            <button type="submit" class="btn btn-primary">{{ notifications.texts.save }}</button>
                        </div>
                    {% endif %}
                </form>
            </div>
        </div>

        {% for card in cards %}
            {% if card.links is not empty %}
                <div class="row" data-peb-view="section-{{ loop.index }}" data-title="{{ card.name }}" data-description="{{ card.description }}" hidden>
                    {% for page in card.links %}
                        <div class="col-lg-4 mb-4">
                            <div class="card h-100 mb-0 peb-settings__card">
                                <div class="card-body d-flex align-items-center">
                                    {{ _self.icon(card.icon) }}
                                    <a href="{{ page.href }}" class="stretched-link text-reset font-weight-bold peb-settings__name peb-settings__text">{{ page.name }}</a>
                                    <i class="material-icons text-muted ml-3" aria-hidden="true">chevron_right</i>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endfor %}


        {# A module with pages of its own opens on them like a section. #}
        {% for card in menuModules %}
            {% if card.links is not empty %}
                <div class="row" data-peb-view="module-{{ loop.index }}" data-title="{{ card.name }}" data-description="{{ card.description }}" hidden>
                    {% for page in card.links %}
                        <div class="col-lg-4 mb-4">
                            <div class="card h-100 mb-0 peb-settings__card">
                                <div class="card-body d-flex align-items-center">
                                    {{ _self.icon(card.icon) }}
                                    <a href="{{ page.href }}" class="stretched-link text-reset font-weight-bold peb-settings__name peb-settings__text">{{ page.name }}</a>
                                    <i class="material-icons text-muted ml-3" aria-hidden="true">chevron_right</i>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endfor %}

        {# Shown for a moment while the view changes. #}
        <div class="row" data-peb-view="waiting" hidden>
            {% for i in 1..6 %}
                <div class="col-lg-4 mb-4">
                    <div class="card h-100 mb-0 peb-settings__waiting">
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <span class="spinner-border text-secondary" role="status"></span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="d-flex align-items-center mt-2" data-peb-nav hidden>
            <a href="#" class="btn btn-outline-primary" data-peb-back>
                <i class="material-icons peb-settings__back" aria-hidden="true">chevron_left</i> {{ texts.title }}
            </a>
            <span class="mx-3 text-muted" data-peb-trail></span>
        </div>
    </div>
    <script src="{{ pageAssets.js }}" defer></script>
{% endblock %}
